<% layout("/layouts/boilerplate.ejs") %>

<div class="my-2 my-md-4">
    <!-- Profile Header Card -->
    <div class="card border-0 rounded-4 shadow-sm bg-white p-3 p-md-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-center gap-3 gap-md-4">
            <div class="rounded-circle bg-danger-subtle text-danger border border-danger-subtle d-flex align-items-center justify-content-center fw-bold fs-2 flex-shrink-0" style="width: 72px; height: 72px; min-width: 72px;">
                <%= user.username.charAt(0).toUpperCase() %>
            </div>
            <div class="text-center text-md-start flex-grow-1 min-w-0">
                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                    <h3 class="fw-bold mb-0 fs-4 fs-md-3 text-truncate">@<%= user.username %></h3>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="fa-solid fa-shield-check"></i> Verified Member</span>
                </div>
                <p class="text-muted mb-0 small text-truncate"><i class="fa-regular fa-envelope me-1"></i> <%= user.email %></p>
            </div>
            <div class="d-flex gap-3 text-center border-top border-md-top-0 border-md-start pt-3 pt-md-0 ps-md-4 w-100 w-md-auto justify-content-around justify-content-md-start">
                <div class="px-2">
                    <h4 class="fw-bold mb-0 text-danger"><%= bookings.length %></h4>
                    <small class="text-muted">Bookings</small>
                </div>
                <div class="px-2 border-start">
                    <h4 class="fw-bold mb-0 text-danger"><%= user.wishlist ? user.wishlist.length : 0 %></h4>
                    <small class="text-muted">Saved</small>
                </div>
                <div class="px-2 border-start">
                    <h4 class="fw-bold mb-0 text-danger"><%= hostedListings.length %></h4>
                    <small class="text-muted">Hosted</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs (Touch-Scrollable on Mobile) -->
    <div class="profile-tabs-wrapper mb-4 border-bottom pb-2">
        <ul class="nav nav-pills profile-tabs" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings" type="button" role="tab" aria-controls="bookings" aria-selected="true">
                    <i class="fa-solid fa-suitcase-rolling me-1"></i> My Bookings (<%= bookings.length %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="wishlist-tab" data-bs-toggle="tab" data-bs-target="#wishlist" type="button" role="tab" aria-controls="wishlist" aria-selected="false">
                    <i class="fa-solid fa-heart me-1 text-danger"></i> Wishlist (<%= user.wishlist ? user.wishlist.length : 0 %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="hosted-tab" data-bs-toggle="tab" data-bs-target="#hosted" type="button" role="tab" aria-controls="hosted" aria-selected="false">
                    <i class="fa-solid fa-house-user me-1"></i> My Hosted Listings (<%= hostedListings.length %>)
                </button>
            </li>
        </ul>
    </div>

    <!-- Tab Contents -->
    <div class="tab-content" id="profileTabContent">
        <!-- 1. Bookings Tab -->
        <div class="tab-pane fade show active" id="bookings" role="tabpanel" aria-labelledby="bookings-tab">
            <% if (bookings.length === 0) { %>
                <div class="text-center py-5 bg-white rounded-4 border px-3">
                    <i class="fa-solid fa-plane-departure fs-1 text-muted mb-3"></i>
                    <h5 class="fw-bold">No trips booked yet</h5>
                    <p class="text-muted">Time to dust off your bags and start planning your next getaway!</p>
                    <a href="/listings" class="btn btn-primary px-4 rounded-pill">Start Exploring Stays</a>
                </div>
            <% } else { %>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 g-md-4">
                    <% for (let booking of bookings) { %>
                        <div class="col">
                            <div class="listing-card-wrapper">
                                <div class="card h-100 listing-card border rounded-4 shadow-sm bg-white overflow-hidden">
                                    <% if (booking.listing && booking.listing.image) { %>
                                        <div class="listing-card-img-container" style="aspect-ratio: 16 / 10;">
                                            <img src="<%= booking.listing.image.url %>" class="listing-card-img" alt="<%= booking.listing.title %>">
                                        </div>
                                    <% } %>
                                    <div class="listing-card-body p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge <%= booking.status === 'Confirmed' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary' %> px-2 py-1">
                                                <%= booking.status %>
                                            </span>
                                            <small class="text-muted fw-semibold"><%= booking.bookingId %></small>
                                        </div>
                                        <h6 class="fw-bold mb-1 listing-title"><%= booking.listing ? booking.listing.title : "Property Stay" %></h6>
                                        <p class="text-muted small mb-2 listing-location"><i class="fa-solid fa-location-dot text-danger"></i> <%= booking.listing ? booking.listing.location + ', ' + booking.listing.country : "Destination" %></p>
                                        
                                        <div class="bg-light p-2 rounded-3 small mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-muted">Dates:</span>
                                                <span class="fw-semibold"><%= booking.checkIn %> to <%= booking.checkOut %></span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-muted">Guests:</span>
                                                <span class="fw-semibold"><%= booking.guests %></span>
                                            </div>
                                            <div class="d-flex justify-content-between fw-bold text-dark pt-1 border-top">
                                                <span>Total Paid:</span>
                                                <span class="text-danger">&#8377; <%= Number(booking.totalPrice).toLocaleString("en-IN") %></span>
                                            </div>
                                        </div>

                                        <% if (booking.status === "Confirmed") { %>
                                            <form method="post" action="/user/booking/<%= booking._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to cancel this reservation?')">
                                                <button class="btn btn-sm btn-outline-danger w-100 rounded-3">Cancel Reservation</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- 2. Wishlist Tab (1 on mobile, 2 on tablet, 3-4 on laptop/desktop) -->
        <div class="tab-pane fade" id="wishlist" role="tabpanel" aria-labelledby="wishlist-tab">
            <% if (!user.wishlist || user.wishlist.length === 0) { %>
                <div class="text-center py-5 bg-white rounded-4 border px-3">
                    <i class="fa-regular fa-heart fs-1 text-danger mb-3"></i>
                    <h5 class="fw-bold">Your wishlist is empty</h5>
                    <p class="text-muted">Tap the heart on any property card to save your dream vacation spots here.</p>
                    <a href="/listings" class="btn btn-outline-dark px-4 rounded-pill">Discover Stays</a>
                </div>
            <% } else { %>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 g-md-4">
                    <% for (let item of user.wishlist) { %>
                        <div class="col">
                            <div class="listing-card-wrapper">
                                <a href="/listings/<%= item._id %>" class="card-link">
                                    <div class="card h-100 listing-card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
                                        <div class="listing-card-img-container">
                                            <img src="<%= item.image && item.image.url ? item.image.url : '/images/placeholder.jpg' %>" class="listing-card-img" alt="<%= item.title %>">
                                        </div>
                                        <div class="listing-card-body p-3">
                                            <div>
                                                <div class="listing-title" title="<%= item.title %>"><%= item.title %></div>
                                                <div class="listing-location"><i class="fa-solid fa-location-dot text-danger me-1"></i> <%= item.location %>, <%= item.country %></div>
                                            </div>
                                            <div class="listing-price-container">
                                                <span class="listing-price-tag">&#8377; <%= Number(item.price).toLocaleString("en-IN") %></span>
                                                <small class="text-muted fw-normal"> / night</small>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- 3. Hosted Listings Tab (1 on mobile, 2 on tablet, 3-4 on laptop/desktop) -->
        <div class="tab-pane fade" id="hosted" role="tabpanel" aria-labelledby="hosted-tab">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="fw-bold mb-0">Your Properties</h5>
                <a href="/listings/new" class="btn btn-sm btn-primary rounded-pill px-3">
                    <i class="fa-solid fa-plus me-1"></i> Add New Stay
                </a>
            </div>

            <% if (hostedListings.length === 0) { %>
                <div class="text-center py-5 bg-white rounded-4 border px-3">
                    <i class="fa-solid fa-house-chimney fs-1 text-muted mb-3"></i>
                    <h5 class="fw-bold">You haven't listed any properties yet</h5>
                    <p class="text-muted">Earn extra income by opening your doors to travelers around the globe.</p>
                    <a href="/listings/new" class="btn btn-primary px-4 rounded-pill">Host a Property</a>
                </div>
            <% } else { %>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 g-md-4">
                    <% for (let hosted of hostedListings) { %>
                        <div class="col">
                            <div class="listing-card-wrapper">
                                <div class="card h-100 listing-card border rounded-4 shadow-sm bg-white overflow-hidden">
                                    <div class="listing-card-img-container">
                                        <img src="<%= hosted.image && hosted.image.url ? hosted.image.url : '/images/placeholder.jpg' %>" class="listing-card-img" alt="<%= hosted.title %>">
                                    </div>
                                    <div class="listing-card-body p-3">
                                        <div>
                                            <div class="listing-title" title="<%= hosted.title %>"><%= hosted.title %></div>
                                            <div class="listing-location"><i class="fa-solid fa-location-dot text-danger me-1"></i> <%= hosted.location %>, <%= hosted.country %></div>
                                            <div class="listing-price-container mb-3">
                                                <span class="listing-price-tag">&#8377; <%= Number(hosted.price).toLocaleString("en-IN") %></span>
                                                <small class="text-muted fw-normal"> / night</small>
                                            </div>
                                        </div>
                                        
                                        <div class="d-flex gap-2 mt-auto">
                                            <a href="/listings/<%= hosted._id %>/edit" class="btn btn-sm btn-outline-dark flex-grow-1"><i class="fa-solid fa-pen-to-square me-1"></i> Edit</a>
                                            <form method="post" action="/listings/<%= hosted._id %>?_method=DELETE" class="flex-grow-1" onsubmit="return confirm('Are you sure you want to delete this listing?')">
                                                <button class="btn btn-sm btn-outline-danger w-100"><i class="fa-solid fa-trash me-1"></i> Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>
