<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3 mb-5">
    <div class="col-12 col-md-8 offset-md-2">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left"></i> All Listings</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= data.title %></li>
            </ol>
        </nav>
        
        <h2 class="fw-bold mb-3"><%= data.title %></h2>
    </div>

    <!-- Listing Hero Card -->
    <div class="card listing-card col-12 col-md-8 offset-md-2 show-card">
        <img src="<%= data.image.url %>" class="card-img-top show-image" alt="Listing Image" style="height: 24rem; object-fit: cover; border-radius: 1.25rem; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);">
        <div class="card-body pt-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <p class="card-text mb-0">
                    <span class="badge bg-light text-dark border"><i class="fa-solid fa-user-check text-primary"></i> Hosted by @<%= data.owner.username %></span>
                </p>
                <span class="fs-5 fw-bold text-danger">&#8377; <%= Number(data.price).toLocaleString("en-IN") %> <small class="text-muted fs-6 fw-normal">/ night</small></span>
            </div>

            <p class="card-text text-secondary mt-2 fs-6 leading-relaxed">
                <%= data.description %>
            </p>

            <div class="mt-3 p-3 bg-light rounded-3 border d-flex gap-4 flex-wrap">
                <div><i class="fa-solid fa-location-dot text-danger"></i> <strong>Location:</strong> <%= data.location %></div>
                <div><i class="fa-solid fa-globe text-primary"></i> <strong>Country:</strong> <%= data.country %></div>
                <% if(data.category) { %>
                    <div><i class="fa-solid fa-tag text-success"></i> <strong>Category:</strong> <%= data.category %></div>
                <% } %>
            </div>
        </div>
    </div>

    <% if(currUser && data.owner._id.equals(currUser._id)) { %>
        <div class="col-12 col-md-8 offset-md-2 mt-3 d-flex gap-2">
            <a class="btn btn-dark btn-primary px-4 py-2" href="/listings/<%= data._id %>/edit"><i class="fa-solid fa-pen-to-square"></i> Edit Listing</a>
            <form method="post" action="/listings/<%= data._id %>?_method=DELETE">
                <button class="btn btn-outline-danger px-4 py-2"><i class="fa-solid fa-trash"></i> Delete Listing</button>
            </form>
        </div>
    <% } %>

    <!-- Where you will be: Interactive Map Section -->
    <div class="col-12 col-md-8 offset-md-2 mt-4">
        <hr>
        <h4 class="fw-bold mb-1">Where you will be</h4>
        <p class="text-muted"><i class="fa-solid fa-location-dot text-danger"></i> <%= data.location %>, <%= data.country %></p>
        <div id="map" style="height: 320px; width: 100%; border-radius: 1.25rem; box-shadow: 0 4px 15px rgba(0,0,0,0.08); z-index: 1;"></div>
    </div>

    <!-- Review Submission Form -->
    <% if(currUser) { %>
        <div class="col-12 col-md-8 offset-md-2 mt-4">
            <hr>
            <h4 class="fw-bold mb-3">Leave a Review</h4>

            <form class="needs-validation" novalidate method="post" action="/listings/<%= data._id %>/reviews">
                <div class="mb-3">
                    <label for="rating" class="form-label fw-semibold">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3">
                    <label for="comment" class="form-label fw-semibold">Your Experience & Feedback</label>
                    <textarea cols="30" rows="4" required class="form-control" name="review[comment]" placeholder="Write your review about the host, cleanliness, and location..."></textarea>
                    <div class="invalid-feedback">Please add some comment for the review.</div>
                </div>
                <button class="btn btn-dark px-4 py-2">Submit Review</button>
            </form>
        </div>
    <% } %>

    <!-- All Reviews Grid -->
    <div class="col-12 col-md-8 offset-md-2 mt-4">
        <% if(data.reviews && data.reviews.length > 0) { %>
            <hr>
            <h4 class="fw-bold mb-3">Guest Reviews (<%= data.reviews.length %>)</h4> 
            <div class="row g-3">
                <% for(let review of data.reviews) { %>
                    <div class="col-12 col-md-6">
                        <div class="card h-100 p-3 shadow-xs border rounded-3 bg-white">
                            <div class="card-body p-0">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="card-title fw-bold mb-0"><i class="fa-solid fa-circle-user text-secondary"></i> @<%= review.author.username %></h6>
                                </div>
                                <p class="card-text text-warning my-1">
                                    <%= "⭐".repeat(review.rating || 1) %>
                                </p>
                                <p class="card-text text-secondary mb-2" style="font-size: 0.92rem;">
                                    "<%= review.comment %>"
                                </p>
                                <% if(currUser && currUser._id.equals(review.author._id)) { %> 
                                    <form method="post" action="/listings/<%= data._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
                                        <button class="btn btn-sm btn-outline-danger">Delete Review</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<!-- Interactive Geocoding Map Script with OpenStreetMap Nominatim API -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const locationQuery = "<%= data.location %>, <%= data.country %>";
        const mapContainer = document.getElementById("map");
        if (!mapContainer) return;

        let defaultLat = 20.5937;
        let defaultLng = 78.9629;
        let zoomLevel = 5;

        const map = L.map("map").setView([defaultLat, defaultLng], zoomLevel);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "OpenStreetMap"
        }).addTo(map);

        fetch("https://nominatim.openstreetmap.org/search?format=json&q=" + encodeURIComponent(locationQuery))
            .then(res => res.json())
            .then(data => {
                if (data && data.length > 0) {
                    const lat = parseFloat(data[0].lat);
                    const lon = parseFloat(data[0].lon);
                    map.setView([lat, lon], 12);

                    const marker = L.marker([lat, lon]).addTo(map);
                    marker.bindPopup("<b><%= data.title %></b><br><%= data.location %>, <%= data.country %>").openPopup();
                } else {
                    const marker = L.marker([defaultLat, defaultLng]).addTo(map);
                    marker.bindPopup("<b><%= data.title %></b><br><%= data.location %>").openPopup();
                }
            })
            .catch(err => {
                console.log("Map geocoding error:", err);
            });
    });
</script>
