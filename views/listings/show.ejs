<% layout("/layouts/boilerplate.ejs") %>

<div class="container my-4">
    <!-- Breadcrumb & Header -->
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left"></i> All Listings</a></li>
                    <li class="breadcrumb-item active text-dark" aria-current="page"><%= data.title %></li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-1"><%= data.title %></h2>
            <p class="text-muted fs-6 mb-3">
                <i class="fa-solid fa-star text-warning"></i> 4.9 &nbsp;·&nbsp; 
                <span class="text-decoration-underline"><%= data.reviews ? data.reviews.length : 0 %> reviews</span> &nbsp;·&nbsp; 
                <i class="fa-solid fa-location-dot text-danger"></i> <%= data.location %>, <%= data.country %>
            </p>
        </div>
    </div>

    <!-- Main Content 2-Column Grid -->
    <div class="row g-5">
        <!-- Left Column: Image, Description, Amenities, Map, Reviews -->
        <div class="col-12 col-lg-8">
            <!-- Hero Image -->
            <div class="position-relative mb-4">
                <img src="<%= data.image.url %>" class="card-img-top" alt="Listing Image" style="height: 25rem; object-fit: cover; border-radius: 1.5rem; box-shadow: 0 10px 30px -5px rgba(0,0,0,0.12);">
            </div>

            <!-- Host Info -->
            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                <div>
                    <h5 class="fw-bold mb-0">Entire villa hosted by @<%= data.owner.username %></h5>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">4 guests · 2 bedrooms · 2 beds · 2 private baths</p>
                </div>
                <div class="w-12 h-12 rounded-circle bg-light border d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; border-radius: 50%;">
                    <i class="fa-solid fa-user fs-5 text-secondary"></i>
                </div>
            </div>

            <!-- Property Perks -->
            <div class="py-4 border-bottom">
                <div class="d-flex gap-3 mb-3">
                    <i class="fa-solid fa-medal fs-4 text-danger mt-1"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Experienced Host</h6>
                        <p class="text-muted mb-0" style="font-size: 0.88rem;">@<%= data.owner.username %> has 100% 5-star ratings from recent guests.</p>
                    </div>
                </div>
                <div class="d-flex gap-3 mb-3">
                    <i class="fa-solid fa-location-dot fs-4 text-danger mt-1"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Great Location</h6>
                        <p class="text-muted mb-0" style="font-size: 0.88rem;">95% of recent guests gave the location a 5-star rating.</p>
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <i class="fa-solid fa-key fs-4 text-danger mt-1"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Seamless Check-in</h6>
                        <p class="text-muted mb-0" style="font-size: 0.88rem;">Self check-in with smart lock available 24/7.</p>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="py-4 border-bottom">
                <h5 class="fw-bold mb-3">About this space</h5>
                <p class="text-secondary leading-relaxed fs-6">
                    <%= data.description %>
                </p>
                <% if(data.category) { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6 rounded-pill">
                        Category: <%= data.category %>
                    </span>
                <% } %>
            </div>

            <!-- Action Buttons for Owner -->
            <% if(currUser && data.owner._id.equals(currUser._id)) { %>
                <div class="py-3 border-bottom d-flex gap-2">
                    <a class="btn btn-dark btn-primary px-4 py-2" href="/listings/<%= data._id %>/edit"><i class="fa-solid fa-pen-to-square"></i> Edit Listing</a>
                    <form method="post" action="/listings/<%= data._id %>?_method=DELETE">
                        <button class="btn btn-outline-danger px-4 py-2"><i class="fa-solid fa-trash"></i> Delete Listing</button>
                    </form>
                </div>
            <% } %>

            <!-- Where you will be: Interactive Map -->
            <div class="py-4 border-bottom">
                <h5 class="fw-bold mb-1">Where you will be</h5>
                <p class="text-muted mb-3"><i class="fa-solid fa-location-dot text-danger"></i> <%= data.location %>, <%= data.country %></p>
                <div id="map" style="height: 320px; width: 100%; border-radius: 1.25rem; box-shadow: 0 4px 15px rgba(0,0,0,0.08); z-index: 1;"></div>
            </div>

            <!-- Leave a Review Form -->
            <% if(currUser) { %>
                <div class="py-4 border-bottom">
                    <h5 class="fw-bold mb-3">Leave a Review</h5>
                    <form class="needs-validation" novalidate method="post" action="/listings/<%= data._id %>/reviews">
                        <div class="mb-3">
                            <label for="rating" class="form-label fw-semibold">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>

                        <div class="mb-3">
                            <label for="comment" class="form-label fw-semibold">Your Feedback</label>
                            <textarea cols="30" rows="3" required class="form-control" name="review[comment]" placeholder="Share your experience at this property..."></textarea>
                            <div class="invalid-feedback">Please enter a review comment.</div>
                        </div>
                        <button class="btn btn-dark px-4 py-2">Submit Review</button>
                    </form>
                </div>
            <% } %>

            <!-- Reviews List -->
            <div class="py-4">
                <h5 class="fw-bold mb-3">Guest Reviews (<%= data.reviews ? data.reviews.length : 0 %>)</h5>
                <% if(data.reviews && data.reviews.length > 0) { %>
                    <div class="row g-3">
                        <% for(let review of data.reviews) { %>
                            <div class="col-12 col-md-6">
                                <div class="card h-100 p-3 shadow-xs border rounded-3 bg-white">
                                    <div class="card-body p-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="card-title fw-bold mb-0">@<%= review.author.username %></h6>
                                        </div>
                                        <p class="card-text text-warning my-1">
                                            <%= "⭐".repeat(review.rating || 1) %>
                                        </p>
                                        <p class="card-text text-secondary mb-2" style="font-size: 0.9rem;">
                                            "<%= review.comment %>"
                                        </p>
                                        <% if(currUser && currUser._id.equals(review.author._id)) { %> 
                                            <form method="post" action="/listings/<%= data._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
                                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <p class="text-muted">No reviews yet. Be the first guest to leave a review!</p>
                <% } %>
            </div>
        </div>

        <!-- Right Column: Sticky Airbnb Reservation Card -->
        <div class="col-12 col-lg-4">
            <div class="card p-4 reservation-card bg-white sticky-top" style="top: 6rem; z-index: 10;">
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <div>
                        <span class="fs-4 fw-bold text-dark">&#8377; <%= Number(data.price).toLocaleString("en-IN") %></span>
                        <span class="text-muted"> / night</span>
                    </div>
                    <div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="fa-solid fa-star text-warning"></i> 4.9 · Verified</span>
                    </div>
                </div>

                <!-- Date Inputs Container -->
                <div class="border rounded-3 p-2 mb-3">
                    <div class="row g-2">
                        <div class="col-6 border-end pe-2">
                            <label class="form-label text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem;">CHECK-IN</label>
                            <input type="date" id="checkInDate" class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold" style="font-size: 0.85rem;" required>
                        </div>
                        <div class="col-6 ps-2">
                            <label class="form-label text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem;">CHECKOUT</label>
                            <input type="date" id="checkOutDate" class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold" style="font-size: 0.85rem;" required>
                        </div>
                    </div>
                    <div class="border-top pt-2 mt-2">
                        <label class="form-label text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem;">GUESTS</label>
                        <select id="guestCount" class="form-select form-select-sm border-0 p-0 shadow-none fw-semibold" style="font-size: 0.85rem;">
                            <option value="1">1 Guest</option>
                            <option value="2" selected>2 Guests</option>
                            <option value="3">3 Guests</option>
                            <option value="4">4 Guests</option>
                            <option value="5+">5+ Guests</option>
                        </select>
                    </div>
                </div>

                <!-- Reserve Button with Instant Confirmation Alert -->
                <button id="reserveBtn" class="btn btn-danger w-100 py-2 fw-bold fs-6 rounded-3 mb-2" style="background-color: #fe424d !important; border: none !important;">
                    <i class="fa-solid fa-bolt me-1"></i> Reserve Now
                </button>
                <p class="text-center text-muted mb-3" style="font-size: 0.8rem;">You will not be charged yet</p>

                <!-- Live Price Calculation Breakdown -->
                <div class="border-top pt-3" style="font-size: 0.9rem;">
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span id="nightRateLabel">&#8377; <%= Number(data.price).toLocaleString("en-IN") %> x <span id="nightsCount">3</span> nights</span>
                        <span id="basePriceTotal">&#8377; <%= Number(data.price * 3).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span>Cleaning fee</span>
                        <span>&#8377; 1,200</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span>Wanderlust service fee</span>
                        <span>&#8377; 850</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fw-bold text-dark fs-6">
                        <span>Total before taxes</span>
                        <span id="grandTotal">&#8377; <%= Number(data.price * 3 + 1200 + 850).toLocaleString("en-IN") %></span>
                    </div>
                </div>

                <!-- Success Confirmation Box -->
                <div id="bookingConfirmation" class="alert alert-success mt-3 mb-0 d-none text-center" role="alert">
                    <h6 class="fw-bold mb-1"><i class="fa-solid fa-circle-check"></i> Reservation Requested!</h6>
                    <small>Host @<%= data.owner.username %> has been notified.</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts for Map and Dynamic Booking Calculation -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Initialize Map
        const locationQuery = "<%= data.location %>, <%= data.country %>";
        const mapContainer = document.getElementById("map");
        if (mapContainer) {
            let defaultLat = 20.5937;
            let defaultLng = 78.9629;
            const map = L.map("map").setView([defaultLat, defaultLng], 5);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: "OpenStreetMap"
            }).addTo(map);

            fetch("https://nominatim.openstreetmap.org/search?format=json&q=" + encodeURIComponent(locationQuery))
                .then(res => res.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const lat = parseFloat(data[0].lat);
                        const lon = parseFloat(data[0].lon);
                        map.setView([lat, lon], 12);
                        const marker = L.marker([lat, lon]).addTo(map);
                        marker.bindPopup("<b><%= data.title %></b><br><%= data.location %>, <%= data.country %>").openPopup();
                    } else {
                        const marker = L.marker([defaultLat, defaultLng]).addTo(map);
                        marker.bindPopup("<b><%= data.title %></b><br><%= data.location %>").openPopup();
                    }
                })
                .catch(err => console.log("Map error:", err));
        }

        // 2. Dynamic Booking Date & Price Calculations
        const pricePerNight = <%= Number(data.price) || 5000 %>;
        const checkIn = document.getElementById("checkInDate");
        const checkOut = document.getElementById("checkOutDate");
        const nightsCount = document.getElementById("nightsCount");
        const baseTotal = document.getElementById("basePriceTotal");
        const grandTotal = document.getElementById("grandTotal");
        const reserveBtn = document.getElementById("reserveBtn");
        const bookingConfirmation = document.getElementById("bookingConfirmation");

        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        const threeDaysAfter = new Date(today);
        threeDaysAfter.setDate(threeDaysAfter.getDate() + 4);

        if (checkIn && checkOut) {
            checkIn.value = tomorrow.toISOString().split("T")[0];
            checkOut.value = threeDaysAfter.toISOString().split("T")[0];
            checkIn.min = today.toISOString().split("T")[0];

            function calculatePrice() {
                const date1 = new Date(checkIn.value);
                const date2 = new Date(checkOut.value);
                let diffTime = date2 - date1;
                let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (diffDays <= 0) diffDays = 1;

                nightsCount.innerText = diffDays;
                const base = pricePerNight * diffDays;
                baseTotal.innerText = "₹ " + base.toLocaleString("en-IN");
                grandTotal.innerText = "₹ " + (base + 1200 + 850).toLocaleString("en-IN");
            }

            checkIn.addEventListener("change", () => {
                checkOut.min = checkIn.value;
                calculatePrice();
            });
            checkOut.addEventListener("change", calculatePrice);
        }

        if (reserveBtn) {
            reserveBtn.addEventListener("click", () => {
                bookingConfirmation.classList.remove("d-none");
                reserveBtn.classList.add("btn-success");
                reserveBtn.classList.remove("btn-danger");
                reserveBtn.innerHTML = "<i class="fa-solid fa-check me-1"></i> Reserved!";
            });
        }
    });
</script>
