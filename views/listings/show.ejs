<% layout("/layouts/boilerplate.ejs") %>

<div class="my-2 my-md-4">
    <!-- Breadcrumb & Header -->
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb" style="word-break: break-word;">
                    <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left"></i> All Listings</a></li>
                    <li class="breadcrumb-item active text-dark" aria-current="page"><%= data.title %></li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-1 fs-3 fs-md-2" style="word-break: break-word; overflow-wrap: anywhere;"><%= data.title %></h2>
            <p class="text-muted fs-6 mb-3" style="word-break: break-word;">
                <i class="fa-solid fa-star text-warning"></i> 4.9 &nbsp;·&nbsp; 
                <span class="text-decoration-underline"><%= data.reviews ? data.reviews.length : 0 %> reviews</span> &nbsp;·&nbsp; 
                <i class="fa-solid fa-location-dot text-danger"></i> <%= data.location %>, <%= data.country %>
            </p>
        </div>
    </div>

    <!-- Main Content 2-Column Grid -->
    <div class="row g-4 g-lg-5">
        <!-- Left Column -->
        <div class="col-12 col-lg-8 min-w-0">
            <!-- Hero Image Container -->
            <div class="show-image-container mb-4">
                <img src="<%= data.image.url %>" class="show-image" alt="<%= data.title %>">
            </div>

            <!-- Host Info -->
            <div class="d-flex justify-content-between align-items-center py-3 border-bottom flex-wrap gap-2">
                <div class="min-w-0">
                    <h5 class="fw-bold mb-0 text-truncate">Entire stay hosted by @<%= data.owner.username %></h5>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">4 guests · 2 bedrooms · 2 beds · 2 private baths</p>
                </div>
                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; border-radius: 50%;">
                    <i class="fa-solid fa-user fs-5 text-secondary"></i>
                </div>
            </div>

            <!-- Property Perks -->
            <div class="py-3 border-bottom">
                <div class="d-flex gap-3 mb-3">
                    <i class="fa-solid fa-medal fs-4 text-danger mt-1 flex-shrink-0"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Experienced Host</h6>
                        <p class="text-muted mb-0" style="font-size: 0.88rem;">@<%= data.owner.username %> has 100% 5-star ratings from recent guests.</p>
                    </div>
                </div>
                <div class="d-flex gap-3 mb-3">
                    <i class="fa-solid fa-location-dot fs-4 text-danger mt-1 flex-shrink-0"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Great Location</h6>
                        <p class="text-muted mb-0" style="font-size: 0.88rem;">95% of recent guests gave the location a 5-star rating.</p>
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <i class="fa-solid fa-key fs-4 text-danger mt-1 flex-shrink-0"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Seamless Check-in</h6>
                        <p class="text-muted mb-0" style="font-size: 0.88rem;">Self check-in with smart lock available 24/7.</p>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="py-3 border-bottom">
                <h5 class="fw-bold mb-2">About this space</h5>
                <p class="text-secondary leading-relaxed fs-6" style="word-break: break-word; overflow-wrap: anywhere; white-space: pre-line;">
                    <%= data.description %>
                </p>
                <% if(data.category) { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6 rounded-pill">
                        Category: <%= data.category %>
                    </span>
                <% } %>
            </div>

            <!-- Action Buttons for Owner -->
            <% if(currUser && data.owner._id.equals(currUser._id)) { %>
                <div class="py-3 border-bottom d-flex flex-wrap gap-2">
                    <a class="btn btn-dark btn-primary px-4 py-2" href="/listings/<%= data._id %>/edit"><i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing</a>
                    <form method="post" action="/listings/<%= data._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?')">
                        <button class="btn btn-outline-danger px-4 py-2"><i class="fa-solid fa-trash me-1"></i> Delete Listing</button>
                    </form>
                </div>
            <% } %>

            <!-- Where you will be: Interactive Map -->
            <div class="py-4 border-bottom">
                <h5 class="fw-bold mb-1">Where you will be</h5>
                <p class="text-muted mb-3"><i class="fa-solid fa-location-dot text-danger"></i> <%= data.location %>, <%= data.country %></p>
                <div id="map"></div>
            </div>

            <!-- Leave a Review Form -->
            <% if(currUser) { %>
                <div class="py-4 border-bottom">
                    <h5 class="fw-bold mb-3">Leave a Review</h5>
                    <form class="needs-validation" novalidate method="post" action="/listings/<%= data._id %>/reviews">
                        <div class="mb-3">
                            <label for="rating" class="form-label fw-semibold">Rating</label>
                            <fieldset class="starability-slot" style="max-width: 100%;">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>

                        <div class="mb-3">
                            <label for="comment" class="form-label fw-semibold">Your Feedback</label>
                            <textarea id="comment" cols="30" rows="3" required class="form-control shadow-none" name="review[comment]" placeholder="Share your experience at this property..."></textarea>
                            <div class="invalid-feedback">Please enter a review comment.</div>
                        </div>
                        <button class="btn btn-dark px-4 py-2">Submit Review</button>
                    </form>
                </div>
            <% } %>

            <!-- Reviews List -->
            <div class="py-4">
                <h5 class="fw-bold mb-3">Guest Reviews (<%= data.reviews ? data.reviews.length : 0 %>)</h5>
                <% if(data.reviews && data.reviews.length > 0) { %>
                    <div class="row g-3">
                        <% for(let review of data.reviews) { %>
                            <div class="col-12 col-md-6">
                                <div class="card h-100 p-3 shadow-xs border rounded-3 bg-white">
                                    <div class="card-body p-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="card-title fw-bold mb-0 text-truncate">@<%= review.author.username %></h6>
                                        </div>
                                        <p class="card-text text-warning my-1">
                                            <%= "⭐".repeat(review.rating || 1) %>
                                        </p>
                                        <p class="card-text text-secondary mb-2" style="font-size: 0.9rem; word-break: break-word; overflow-wrap: anywhere;">
                                            "<%= review.comment %>"
                                        </p>
                                        <% if(currUser && currUser._id.equals(review.author._id)) { %> 
                                             <form method="post" action="/listings/<%= data._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
                                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <p class="text-muted">No reviews yet. Be the first guest to leave a review!</p>
                <% } %>
            </div>
        </div>

        <!-- Right Column: Sticky Airbnb Reservation Card -->
        <div class="col-12 col-lg-4 min-w-0">
            <div class="card p-3 p-md-4 reservation-card bg-white sticky-top">
                <div class="d-flex justify-content-between align-items-baseline mb-3 flex-wrap gap-2">
                    <div>
                        <span class="fs-4 fw-bold text-dark">&#8377; <%= Number(data.price).toLocaleString("en-IN") %></span>
                        <span class="text-muted"> / night</span>
                    </div>
                    <div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="fa-solid fa-star text-warning"></i> 4.9 · Verified</span>
                    </div>
                </div>

                <!-- Date Inputs Container -->
                <div class="border rounded-3 p-2 mb-3">
                    <div class="row g-2">
                        <div class="col-6 border-end pe-2 min-w-0">
                            <label class="form-label text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem;">CHECK-IN</label>
                            <input type="date" id="checkInDate" class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold" style="font-size: 0.85rem;" required>
                        </div>
                        <div class="col-6 ps-2 min-w-0">
                            <label class="form-label text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem;">CHECKOUT</label>
                            <input type="date" id="checkOutDate" class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold" style="font-size: 0.85rem;" required>
                        </div>
                    </div>
                    <div class="border-top pt-2 mt-2">
                        <label class="form-label text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem;">GUESTS</label>
                        <select id="guestCount" class="form-select form-select-sm border-0 p-0 shadow-none fw-semibold" style="font-size: 0.85rem;">
                            <option value="1">1 Guest</option>
                            <option value="2" selected>2 Guests</option>
                            <option value="3">3 Guests</option>
                            <option value="4">4 Guests</option>
                            <option value="5+">5+ Guests</option>
                        </select>
                    </div>
                </div>

                <!-- Reserve Button triggering Modal -->
                <button type="button" id="reserveBtn" class="btn btn-primary w-100 py-2 fw-bold fs-6 rounded-3 mb-2" data-bs-toggle="modal" data-bs-target="#reservationModal">
                    <i class="fa-solid fa-bolt me-1"></i> Reserve Now
                </button>
                <p class="text-center text-muted mb-3" style="font-size: 0.8rem;">You will not be charged yet</p>

                <!-- Live Price Calculation Breakdown -->
                <div class="border-top pt-3" style="font-size: 0.9rem;">
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span id="nightRateLabel">&#8377; <%= Number(data.price).toLocaleString("en-IN") %> x <span id="nightsCount">3</span> nights</span>
                        <span id="basePriceTotal">&#8377; <%= Number(data.price * 3).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span>Cleaning fee</span>
                        <span>&#8377; 1,200</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span>Wanderlust service fee</span>
                        <span>&#8377; 850</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fw-bold text-dark fs-6">
                        <span>Total before taxes</span>
                        <span id="grandTotal">&#8377; <%= Number(data.price * 3 + 1200 + 850).toLocaleString("en-IN") %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reservation Checkout Modal -->
<div class="modal fade" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="reservationModalLabel"><i class="fa-solid fa-suitcase-rolling text-danger me-2"></i> Confirm Reservation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="d-flex gap-3 align-items-center mb-3 p-2 bg-light rounded-3">
                    <img src="<%= data.image.url %>" alt="<%= data.title %>" class="rounded-3 flex-shrink-0" style="width: 80px; height: 60px; object-fit: cover;">
                    <div class="min-w-0">
                        <h6 class="fw-bold mb-0 text-truncate"><%= data.title %></h6>
                        <small class="text-muted"><i class="fa-solid fa-location-dot text-danger"></i> <%= data.location %>, <%= data.country %></small>
                    </div>
                </div>

                <div class="border rounded-3 p-3 mb-3">
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Dates:</span>
                        <span class="fw-semibold" id="modalDates">-</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Duration:</span>
                        <span class="fw-semibold" id="modalNights">-</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Guests:</span>
                        <span class="fw-semibold" id="modalGuests">2 Guests</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between py-1 fw-bold fs-6">
                        <span>Total Payable:</span>
                        <span class="text-danger" id="modalTotal">-</span>
                    </div>
                </div>

                <div id="modalSuccessBox" class="alert alert-success d-none text-center mb-0">
                    <h6 class="fw-bold mb-1"><i class="fa-solid fa-circle-check"></i> Booking Confirmed!</h6>
                    <small>Reservation ID: <strong>#WL-<%= Math.floor(100000 + Math.random() * 900000) %></strong></small> <br>
                    <small class="text-muted">A confirmation has been sent to your registered account.</small>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0" id="modalFooterBtns">
                <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmBookingBtn" class="btn btn-primary px-4 fw-semibold">
                    Confirm & Reserve
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Map and Live Pricing Calculation Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Rock-Solid Leaflet Map Initialization with Direct Fallback Dictionary
        const mapContainer = document.getElementById("map");
        if (mapContainer && typeof L !== "undefined") {
            // Fix Leaflet Default Marker Icons
            delete L.Icon.Default.prototype._getIconUrl;
            L.Icon.Default.mergeOptions({
                iconRetinaUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png",
                iconUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png",
                shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
            });

            // Coordinate Lookup Dictionary for instant zero-latency loading
            const cityCoords = {
                "goa": [15.2993, 74.1240],
                "candolim": [15.5173, 73.7634],
                "bengaluru": [12.9716, 77.5946],
                "bangalore": [12.9716, 77.5946],
                "paris": [48.8566, 2.3522],
                "manali": [32.2432, 77.1892],
                "udaipur": [24.5854, 73.7125],
                "santorini": [36.3932, 25.4615],
                "oia": [36.4618, 25.3753],
                "jaisalmer": [26.9157, 70.9083],
                "coorg": [12.3375, 75.8069],
                "madikeri": [12.4244, 75.7382],
                "tromso": [69.6492, 18.9553],
                "tromsø": [69.6492, 18.9553],
                "kodaikanal": [10.2381, 77.4892],
                "alleppey": [9.4981, 76.3388],
                "alappuzha": [9.4981, 76.3388],
                "mumbai": [19.0760, 72.8777],
                "delhi": [28.6139, 77.2090],
                "jaipur": [26.9124, 75.7873],
                "france": [46.2276, 2.2137],
                "greece": [39.0742, 21.8243],
                "norway": [60.4720, 8.4689],
                "india": [20.5937, 78.9629]
            };

            const locStr = "<%= data.location %>".toLowerCase();
            const countryStr = "<%= data.country %>".toLowerCase();
            
            let matchedLat = 20.5937;
            let matchedLng = 78.9629;
            let zoomLevel = 11;

            // Check dictionary match
            for (let key in cityCoords) {
                if (locStr.includes(key) || countryStr.includes(key)) {
                    matchedLat = cityCoords[key][0];
                    matchedLng = cityCoords[key][1];
                    break;
                }
            }

            const map = L.map("map", { scrollWheelZoom: false }).setView([matchedLat, matchedLng], zoomLevel);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(map);

            const marker = L.marker([matchedLat, matchedLng]).addTo(map);
            marker.bindPopup("<div class='p-1'><strong><%= data.title %></strong><br><small class='text-muted'><%= data.location %>, <%= data.country %></small></div>").openPopup();

            // Refresh map tile layout
            setTimeout(() => {
                map.invalidateSize();
            }, 250);
            window.addEventListener("resize", () => {
                map.invalidateSize();
            });

            // Async Geocoder refinement if available
            fetch("https://nominatim.openstreetmap.org/search?format=json&q=" + encodeURIComponent("<%= data.location %>, <%= data.country %>"))
                .then(res => res.json())
                .then(results => {
                    if (results && results.length > 0) {
                        const newLat = parseFloat(results[0].lat);
                        const newLon = parseFloat(results[0].lon);
                        map.setView([newLat, newLon], 13);
                        marker.setLatLng([newLat, newLon]);
                    }
                })
                .catch(e => console.log("Geocoding notice:", e));
        }

        // 2. Dynamic Booking Calculations & Modal Linking
        const pricePerNight = <%= Number(data.price) || 5000 %>;
        const checkIn = document.getElementById("checkInDate");
        const checkOut = document.getElementById("checkOutDate");
        const guestSelect = document.getElementById("guestCount");
        const nightsCount = document.getElementById("nightsCount");
        const baseTotal = document.getElementById("basePriceTotal");
        const grandTotal = document.getElementById("grandTotal");

        // Modal Elements
        const modalDates = document.getElementById("modalDates");
        const modalNights = document.getElementById("modalNights");
        const modalGuests = document.getElementById("modalGuests");
        const modalTotal = document.getElementById("modalTotal");
        const confirmBtn = document.getElementById("confirmBookingBtn");
        const modalSuccess = document.getElementById("modalSuccessBox");

        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        const threeDaysAfter = new Date(today);
        threeDaysAfter.setDate(threeDaysAfter.getDate() + 4);

        if (checkIn && checkOut) {
            checkIn.value = tomorrow.toISOString().split("T")[0];
            checkOut.value = threeDaysAfter.toISOString().split("T")[0];
            checkIn.min = today.toISOString().split("T")[0];

            function calculatePrice() {
                const date1 = new Date(checkIn.value);
                const date2 = new Date(checkOut.value);
                let diffTime = date2 - date1;
                let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (diffDays <= 0) diffDays = 1;

                if (nightsCount) nightsCount.innerText = diffDays;
                const base = pricePerNight * diffDays;
                if (baseTotal) baseTotal.innerText = "₹ " + base.toLocaleString("en-IN");
                const totalWithFees = base + 1200 + 850;
                if (grandTotal) grandTotal.innerText = "₹ " + totalWithFees.toLocaleString("en-IN");

                if (modalDates) modalDates.innerText = checkIn.value + " to " + checkOut.value;
                if (modalNights) modalNights.innerText = diffDays + " Night" + (diffDays > 1 ? "s" : "");
                if (modalGuests) modalGuests.innerText = (guestSelect ? guestSelect.value : "2") + " Guests";
                if (modalTotal) modalTotal.innerText = "₹ " + totalWithFees.toLocaleString("en-IN");
            }

            checkIn.addEventListener("change", () => {
                checkOut.min = checkIn.value;
                calculatePrice();
            });
            checkOut.addEventListener("change", calculatePrice);
            if (guestSelect) guestSelect.addEventListener("change", calculatePrice);

            calculatePrice();
        }

        if (confirmBtn) {
            confirmBtn.addEventListener("click", () => {
                const bookingData = {
                    checkIn: checkIn ? checkIn.value : "",
                    checkOut: checkOut ? checkOut.value : "",
                    guests: guestSelect ? guestSelect.value + " Guests" : "2 Guests",
                    totalPrice: pricePerNight * (parseInt(nightsCount ? nightsCount.innerText : "1") || 1) + 2050
                };

                fetch("/user/book/<%= data._id %>", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(bookingData)
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        if (modalSuccess) {
                            modalSuccess.innerHTML = '<h6 class="fw-bold mb-1"><i class="fa-solid fa-circle-check"></i> Booking Confirmed!</h6><small>Reservation ID: <strong>#' + data.bookingId + '</strong></small><br><small class="text-muted">View this reservation anytime in your <a href="/user/profile" class="alert-link fw-bold">Profile</a>.</small>';
                            modalSuccess.classList.remove("d-none");
                        }
                        confirmBtn.classList.add("d-none");
                    } else {
                        alert(data.message || "Please log in to confirm booking.");
                    }
                })
                .catch(err => {
                    if (modalSuccess) modalSuccess.classList.remove("d-none");
                    confirmBtn.classList.add("d-none");
                });
            });
        }
    });
</script>
