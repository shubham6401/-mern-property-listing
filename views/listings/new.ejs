
<% layout("/layouts/boilerplate.ejs") %>

        
        <div class="row">
            <div class="col-12 col-md-8 offset-md-2 mt-3 p-3 bg-white rounded-4 border shadow-sm">
                <h1 class="mb-3">Create new Listing</h1>
                <form class="needs-validation" novalidate method="post" enctype="multipart/form-data" action="/listings">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" name="listing[title]" placeholder="Enter Titile" required class="form-control">
                        <div class="invalid-feedback">Enter Valid Title</div>
                    </div>
                    

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea type="text" name="listing[description]" required placeholder="Enter Description"
                            class="form-control"></textarea>
                        <div class="invalid-feedback">Enter Valid Title</div>

                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Upload listing image..</label>
                        <input type="file" name="listing[image][url]"  class="form-control">

                    </div>
                    <div class="row ">

                    

                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input   required name="listing[price]" placeholder="1,200" class="form-control">
                        <div class="invalid-feedback">Enter Price</div>

                    </div>

                     <div class="mb-3 col-md-8" >
                        <label for="country" class="form-label">Country</label>
                        <input type="text"  required name="listing[country]" placeholder="India" class="form-control">
                        <div class="invalid-feedback">Enter Country</div>

                    </div>
                    </div>

                    
                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select name="listing[category]" class="form-select" required>
                            <option value="Trending">🔥 Trending</option>
                            <option value="Rooms">🛏️ Rooms</option>
                            <option value="Iconic Cities">🏙️ Iconic Cities</option>
                            <option value="Mountains">🏔️ Mountains</option>
                            <option value="Castles">🏰 Castles</option>
                            <option value="Amazing Pools">🏊 Amazing Pools</option>
                            <option value="Camping">⛺ Camping</option>
                            <option value="Farms">🌾 Farms</option>
                            <option value="Arctic">❄️ Arctic</option>
                            <option value="Domes">🛖 Domes</option>
                            <option value="Boats">🚢 Boats</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input type="text"  required name="listing[location]" placeholder="Uttarpradesh" class="form-control">
                        <div class="invalid-feedback">Enter Location</div>

                    </div> 
                    <button  type="submit" class="btn btn-primary mt-3">Add</button>
                </form>
            </div>
        </div>