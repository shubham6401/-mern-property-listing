<%- layout("/layouts/boilerplate.ejs") %>

<!-- Category Filters & Tax Toggle Wrapper -->
<div class="filters-wrapper">
    <div id="filters">
        <a href="/listings?category=Trending" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Trending" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </a>
        <a href="/listings?category=Rooms" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Rooms" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </a>
        <a href="/listings?category=Iconic Cities" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Iconic Cities" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </a>
        <a href="/listings?category=Mountains" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Mountains" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </a>
        <a href="/listings?category=Castles" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Castles" ? "active-filter" : "" %>">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </a>
        <a href="/listings?category=Amazing Pools" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Amazing Pools" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </a>
        <a href="/listings?category=Camping" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Camping" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </a>
        <a href="/listings?category=Farms" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Farms" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </a>
        <a href="/listings?category=Arctic" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Arctic" ? "active-filter" : "" %>">
            <div><i class="fa-regular fa-snowflake"></i></div>
            <p>Arctic</p>
        </a>
        <a href="/listings?category=Domes" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Domes" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </a>
        <a href="/listings?category=Boats" class="filter <%= typeof selectedCategory !== "undefined" && selectedCategory === "Boats" ? "active-filter" : "" %>">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
        </a>
    </div>

    <!-- Tax Switch Toggle -->
    <div class="tax-toggle">
        <div class="form-check form-switch d-flex align-items-center justify-content-between w-100 m-0 p-0">
            <label class="form-check-label me-3" for="flexSwitchCheckDefault" style="cursor: pointer; font-size: 0.85rem; font-weight: 600;">Display total after taxes</label>
            <input class="form-check-input float-none ms-auto" type="checkbox" role="switch" id="flexSwitchCheckDefault" style="cursor: pointer;">
        </div>
    </div>
</div>

<% if (data.length === 0) { %>
    <div class="alert alert-warning mt-4 text-center py-4 rounded-4" role="alert">
        <i class="fa-solid fa-magnifying-glass fs-3 text-warning mb-2"></i>
        <h5 class="fw-bold">No listings found</h5>
        <p class="text-muted mb-0">We couldn't find any stays matching your criteria. <a href="/listings" class="alert-link text-danger fw-bold">View all listings</a></p>
    </div>
<% } %>

<!-- Responsive Listings Cards Grid: 1 on Mobile, 2 on Tablet, 3 on Desktop, 4 on Widescreen/Laptop -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 g-md-4 mt-1">
    <% for(let listing of data) { %>
        <div class="col">
            <div class="listing-card-wrapper">
                <a class="card-link" href="/listings/<%= listing._id %>">
                    <div class="card listing-card h-100">
                        <!-- Image Container with Strict Aspect Ratio -->
                        <div class="listing-card-img-container">
                            <img src="<%= listing.image && listing.image.url ? listing.image.url : '/images/placeholder.jpg' %>" class="listing-card-img" alt="<%= listing.title %>" loading="lazy">
                            
                            <% if (listing.category) { %>
                                <span class="listing-category-badge"><%= listing.category %></span>
                            <% } %>

                            <!-- Floating Wishlist Button -->
                            <button type="button" class="wishlist-btn" data-id="<%= listing._id %>" onclick="toggleWishlist(event, this, '<%= listing._id %>')" title="Save to wishlist" aria-label="Save to wishlist">
                                <i class="fa-regular fa-heart"></i>
                            </button>
                        </div>

                        <!-- Card Body -->
                        <div class="listing-card-body">
                            <div>
                                <div class="listing-title" title="<%= listing.title %>"><%= listing.title %></div>
                                <div class="listing-location">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                    <%= listing.location ? listing.location : '' %><%= listing.location && listing.country ? ', ' : '' %><%= listing.country ? listing.country : '' %>
                                </div>
                            </div>

                            <!-- Price Container with Tax Toggle support -->
                            <div class="listing-price-container">
                                <span class="listing-price-tag">&#8377; <%= Number(listing.price || 0).toLocaleString("en-IN") %></span>
                                <span class="text-muted" style="font-size: 0.85rem;"> / night</span>
                                <span class="tax-info"> &nbsp;·&nbsp; &#8377; <%= Number((listing.price || 0) * 1.18).toLocaleString("en-IN", {maximumFractionDigits: 0}) %> total</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    <% } %>
</div>

<!-- Real-Time Tax Toggle & Wishlist Script -->
<script>
    const taxSwitch = document.getElementById("flexSwitchCheckDefault");
    if (taxSwitch) {
        taxSwitch.addEventListener("click", () => {
            const taxInfo = document.getElementsByClassName("tax-info");
            for (let info of taxInfo) {
                if (info.style.display !== "inline") {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
        });
    }

    function toggleWishlist(e, btn, listingId) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        fetch("/user/wishlist/" + listingId, { method: "POST" })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const icon = btn.querySelector("i");
                    if (data.saved) {
                        btn.classList.add("active-heart");
                        icon.classList.remove("fa-regular");
                        icon.classList.add("fa-solid");
                        icon.style.color = "#fe424d";
                        localStorage.setItem("wishlist_" + listingId, "true");
                    } else {
                        btn.classList.remove("active-heart");
                        icon.classList.remove("fa-solid");
                        icon.classList.add("fa-regular");
                        icon.style.color = "#222222";
                        localStorage.removeItem("wishlist_" + listingId);
                    }
                } else if (data.message) {
                    alert(data.message);
                }
            })
            .catch(() => {
                const icon = btn.querySelector("i");
                const isSaved = btn.classList.toggle("active-heart");
                if (isSaved) {
                    icon.classList.remove("fa-regular");
                    icon.classList.add("fa-solid");
                    icon.style.color = "#fe424d";
                    localStorage.setItem("wishlist_" + listingId, "true");
                } else {
                    icon.classList.remove("fa-solid");
                    icon.classList.add("fa-regular");
                    icon.style.color = "#222222";
                    localStorage.removeItem("wishlist_" + listingId);
                }
            });
    }

    // Load saved wishlist hearts
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".wishlist-btn").forEach(function (btn) {
            const id = btn.getAttribute("data-id");
            if (id && localStorage.getItem("wishlist_" + id) === "true") {
                btn.classList.add("active-heart");
                const icon = btn.querySelector("i");
                if (icon) {
                    icon.classList.remove("fa-regular");
                    icon.classList.add("fa-solid");
                    icon.style.color = "#fe424d";
                }
            }
        });
    });
</script>
